#!/bin/bash

set -euo pipefail

if (( $# != 1 )); then
	echo "Usage: ${0##*/} PDF" >&2
	exit 2
fi

input=$1
tmpdir=$(mktemp -d)
trap 'rm -rf -- "$tmpdir"' EXIT

if ! exiftool -all= -o "${tmpdir}/stripped.pdf" "${input}"; then
	echo "ExifTool could not read the PDF; repairing it with qpdf." >&2
	rm -f -- "${tmpdir}/stripped.pdf"
	qpdf --warning-exit-0 "${input}" "${tmpdir}/repaired.pdf"
	exiftool -all= -o "${tmpdir}/stripped.pdf" "${tmpdir}/repaired.pdf"
fi

gs -o "${tmpdir}/anonymous.pdf" -sDEVICE=pdfwrite \
	-dCompatibilityLevel=1.4 "${tmpdir}/stripped.pdf"

mv -- "${input}" "${input}"~
mv -- "${tmpdir}/anonymous.pdf" "${input}"
